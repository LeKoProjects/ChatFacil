# NEXO Chat — produção (chat.nexoti.com.br).
# Não preencha à mão: rode ./deploy/setup-env.sh, que copia este arquivo para
# .env e gera as chaves e senhas aleatórias marcadas com __GERAR__.
APP_NAME="NEXO Chat"
APP_ENV=production
APP_KEY=__GERAR__
APP_DEBUG=false
APP_URL=https://chat.nexoti.com.br
APP_PORT=8090
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nexo_chat
DB_USERNAME=nexo
DB_PASSWORD=__GERAR__

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_BLOCK_FOR=5

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@nexoti.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb: o Laravel publica eventos no contêiner "reverb" pela rede interna...
REVERB_APP_ID=__GERAR__
REVERB_APP_KEY=__GERAR__
REVERB_APP_SECRET=__GERAR__
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# ...e o navegador conecta pelo domínio público, em HTTPS (o Apache encaminha /app).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=chat.nexoti.com.br
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
